# Frontend runtime config (Vite). Copy to .env and adjust per environment.

# Base URL of the backend API, INCLUDING the /api suffix.
# Local dev default (when unset): http://localhost:5000/api
# Production example (Vercel → Settings → Environment Variables):
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
