PORT=5000
MONGO_URI=mongodb://localhost:27017/school_management

# ── SuperAdmin portal (REQUIRED in production) ───────────────────────────────
# The platform-owner login. There is NO built-in default: if these are unset the
# SuperAdmin portal is disabled, and in production the server refuses to start.
# Choose a unique email and a long, random password.
SA_EMAIL=change-me@your-domain.com
SA_PASSWORD=change-me-to-a-long-random-password

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
NODE_ENV=development

# Comma-separated allowed CORS origins (production). Defaults to localhost dev ports if unset.
# CORS_ORIGINS=https://app.yourschool.com

# Public base URL of THIS backend (used to build public links for WhatsApp media).
# PUBLIC_URL=https://api.yourschool.com

# ── Email (free options) ─────────────────────────────────────────────────────
# Option A — Gmail (use a Google "App Password", NOT your normal password):
# EMAIL_USER=youraddress@gmail.com
# EMAIL_PASS=your-16-char-app-password
# EMAIL_FROM="Your School" <youraddress@gmail.com>
#
# Option B — any SMTP provider (Brevo/Resend/etc.):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-key
# EMAIL_FROM=no-reply@yourschool.com
#
# If none of the above are set, emails are SIMULATED (logged to the console).

# ── WhatsApp (optional, Meta Cloud API) ──────────────────────────────────────
# Leave unset to keep WhatsApp in simulated/sandbox mode (logged, no cost).
# WHATSAPP_TOKEN=your-meta-permanent-token
# WHATSAPP_PHONE_ID=your-whatsapp-business-phone-number-id
# Default language code for pre-approved TEMPLATE messages (proactive reminders
# sent outside the 24h window). Defaults to "en" if unset.
# WHATSAPP_TEMPLATE_LANG=en
#
# IMPORTANT — proactive WhatsApp needs approved TEMPLATES. Automated absence
# and fee reminders are business-initiated (sent outside any 24h reply window),
# which Meta only delivers via a pre-approved message template. Create the two
# templates in WhatsApp Manager and put their names here. If these are unset,
# the engine falls back to free-form text, which Meta REJECTS outside a window
# — so parents silently receive nothing. (In-app / email / SMS are unaffected.)
#   Absence template placeholders:  {{1}} student  {{2}} class  {{3}} date
#   Fee template placeholders:      {{1}} student  {{2}} month year  {{3}} balance  {{4}} due date/"overdue"
# WHATSAPP_TEMPLATE_ABSENCE=absence_alert
# WHATSAPP_TEMPLATE_FEE_REMINDER=fee_reminder

# ── SMS (optional, Twilio REST API) ──────────────────────────────────────────
# Leave unset to keep SMS in simulated mode (logged, no cost). SMS is PAID.
# TWILIO_FROM accepts a Twilio sender number (e.g. +1234567890) OR a Messaging
# Service SID (starts with "MG").
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM=+1234567890

# ── Phone number formatting (shared by SMS + WhatsApp) ───────────────────────
# Country code used to normalise local numbers to international format
# (e.g. 03xx… → +923xx…). Digits only. Defaults to 92 (Pakistan) if unset.
# SMS_COUNTRY_CODE=92
